import { NextResponse } from 'next/server';

export const dynamic = 'force-dynamic';

type AccountAssociation = {
  header: string;
  payload: string;
  signature: string;
};

function cleanUrl(value: string) {
  return value.trim().replace(/\/+$/, '');
}

function getManifestConfig() {
  const appUrl = process.env.NEXT_PUBLIC_APP_URL;

  const accountAssociation: AccountAssociation = {
    header: process.env.FARCASTER_ACCOUNT_ASSOCIATION_HEADER ?? '',
    payload: process.env.FARCASTER_ACCOUNT_ASSOCIATION_PAYLOAD ?? '',
    signature: process.env.FARCASTER_ACCOUNT_ASSOCIATION_SIGNATURE ?? '',
  };

  return {
    appUrl: appUrl ? cleanUrl(appUrl) : '',
    accountAssociation,
  };
}

export async function GET() {
  const { appUrl, accountAssociation } = getManifestConfig();

  const missingAssociation =
    !accountAssociation.header ||
    !accountAssociation.payload ||
    !accountAssociation.signature;

  if (!appUrl || missingAssociation) {
    return NextResponse.json(
      {
        error: 'Farcaster manifest is not configured.',
        requiredEnvironmentVariables: [
          'NEXT_PUBLIC_APP_URL',
          'FARCASTER_ACCOUNT_ASSOCIATION_HEADER',
          'FARCASTER_ACCOUNT_ASSOCIATION_PAYLOAD',
          'FARCASTER_ACCOUNT_ASSOCIATION_SIGNATURE',
        ],
      },
      {
        status: 503,
        headers: {
          'Cache-Control': 'no-store',
        },
      }
    );
  }

  let parsedUrl: URL;

  try {
    parsedUrl = new URL(appUrl);
  } catch {
    return NextResponse.json(
      {
        error:
          'NEXT_PUBLIC_APP_URL must be a full HTTPS URL, such as https://yourdomain.com.',
      },
      {
        status: 503,
        headers: {
          'Cache-Control': 'no-store',
        },
      }
    );
  }

  if (parsedUrl.protocol !== 'https:') {
    return NextResponse.json(
      {
        error: 'Farcaster Mini Apps require an HTTPS production URL.',
      },
      {
        status: 503,
        headers: {
          'Cache-Control': 'no-store',
        },
      }
    );
  }

  const canonicalDomain = parsedUrl.hostname;

  return NextResponse.json(
    {
      accountAssociation,

      miniapp: {
        version: '1',
        name: 'Tobyworld Atlas',
        homeUrl: appUrl,

        iconUrl: `${appUrl}/miniapp/tobyworld-app-icon.png`,
        splashImageUrl: `${appUrl}/miniapp/tobyworld-splash-icon.png`,
        splashBackgroundColor: '#07171f',

        subtitle: 'Read the living flywheel',
        description:
          'Explore Tobyworld lore, discover your signal, and move through the living flywheel.',
        primaryCategory: 'social',

        tags: ['tobyworld', 'toby', 'base', 'lore', 'atlas'],

        heroImageUrl: `${appUrl}/miniapp/tobyworld-og-image.png`,

        tagline: 'Plant stillness tend the world',
        ogTitle: 'Tobyworld Atlas',
        ogDescription: 'Explore the living flywheel of Tobyworld.',
        ogImageUrl: `${appUrl}/miniapp/tobyworld-og-image.png`,

        noindex: false,
        canonicalDomain,
        requiredChains: ['eip155:8453'],
      },
    },
    {
      headers: {
        'Cache-Control':
          'public, max-age=0, s-maxage=300, stale-while-revalidate=86400',
      },
    }
  );
}
